*.blend1
*.blend2

# ==================== Languages and build output ====================
# JavaScript and TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
**/.yarn/cache/
**/.yarn/install-state.gz
.eslintcache
*.tsbuildinfo
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.vite/
coverage/
# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
# Ruby and Jekyll
.bundle/
**/vendor/bundle/
*.rbc
.byebug_history
.yardoc/
_site/
.jekyll-cache/
.jekyll-metadata
# Rust (Cargo.lock stays committed)
target/
**/*.rs.bk
# Go
go.work.sum
*.test
# Java and Kotlin
*.class
.gradle/
.kotlin/
hs_err_pid*
replay_pid*
# C and C++
*.o
*.obj
*.gch
*.pch
*.ilk
*.idb
CMakeFiles/
CMakeCache.txt
cmake-build-*/
cmake_install.cmake
compile_commands.json
.cmake/
# C# and .NET (only the Debug/Release output, so a plain bin/ folder is still allowed)
**/[Bb]in/[Dd]ebug/
**/[Bb]in/[Rr]elease/
.vs/
*.user
*.suo
*.userprefs
*.rsuser
TestResults/
project.lock.json
# Xcode and Swift
xcuserdata/
DerivedData/
*.xcuserstate
.build/
.swiftpm/
# Android
.externalNativeBuild/
.cxx/
local.properties
captures/
# Debug symbols
*.pdb
# General build folders
dist/

# ==================== Logs, temp, and cache ====================
*.log
*.log.*
logs/
tmp/
temp/
.tmp/
*.tmp
.cache/
.sass-cache/

# ==================== Backups ====================
*.bak
*.backup
*.old
*.orig
*.save

# ==================== Secrets ====================
# Environment files. Commit an example file instead.
.env
.env.*
!.env.example
!.env.sample
# SSH keys (public keys are fine to commit)
id_rsa
id_rsa_*
id_ecdsa
id_ecdsa_*
id_ed25519
id_ed25519_*
!*.pub
# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
# VPN configs, password databases, and credential files
*.ovpn
*.kdbx
credentials.json
.netrc
secrets.*
.secrets
config.local.*

# ==================== This repo ====================
# Personal scripts for this machine only
_local-scripts/
