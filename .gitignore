# Files that should never be committed: OS junk, editor files, build output,
# logs, temp files, and secrets. Installers, archives, and binaries are allowed
# on purpose, so a script repo can ship them.

# ==================== macOS ====================
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
.localized
# Custom folder icon file. The name ends with two carriage returns.
Icon

# ==================== Windows ====================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump
# Download marker files left when copying from Windows or WSL
*Zone.Identifier
# Office lock files (~$report.docx)
~$*

# ==================== Linux ====================
*~
.directory
.fuse_hidden*
.nfs*
.Trash-*

# ==================== Editors and IDEs ====================
# VS Code
.vscode/
*.code-workspace
.history/
# JetBrains
.idea/
*.iml
*.ipr
*.iws
# Vim
*.swp
*.swo
.*.sw[a-p]
Session.vim
.netrwhist
# Emacs
\#*\#
.\#*
# Sublime Text
*.sublime-project
*.sublime-workspace
# Eclipse and NetBeans
.project
.classpath
.settings/
/nbproject/private/

# ==================== Build output and dependencies ====================
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache
# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
# Ruby
.bundle/
vendor/bundle/
# Rust
target/
# C and C++ object files
*.o
*.obj
# General build folders
build/
dist/

# ==================== Logs, temp, and cache ====================
*.log
*.log.*
logs/
tmp/
temp/
.tmp/
*.tmp
.cache/
.sass-cache/

# ==================== Backups ====================
*.bak
*.backup
*.old
*.orig
*.save

# ==================== Secrets ====================
# Environment files. Commit an example file instead.
.env
.env.*
!.env.example
!.env.sample
# SSH keys (public keys are fine to commit)
id_rsa
id_rsa_*
id_ecdsa
id_ecdsa_*
id_ed25519
id_ed25519_*
!*.pub
# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
# VPN configs, password databases, and credential files
*.ovpn
*.kdbx
credentials.json
.netrc
secrets.*
.secrets
config.local.*

# ==================== This repo ====================
# Personal scripts for this machine only
_local-scripts/
