[Ll]ogs/
[Uu]ser[Ss]ettings/
[Bb]uild/
[Bb]uilds/
[Mm]emory[Cc]aptures/
[Rr]ecordings/
ExportedObj/
.consulo/
*.pidb
*.pidb.meta
*.booproj
*.svd
*.mdb
*.mdb.meta
*.opendb
*.unityproj
sysinfo.txt
crashlytics-buildid.txt
# Unreal Engine (commit Config/, Content/, Source/ and the .uproject)
Binaries/
Intermediate/
Saved/
DerivedDataCache/
