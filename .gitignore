# Files that should never be committed: OS junk, editor files, build output,
# logs, temp files, and secrets. Installers, archives, and binaries are allowed
# on purpose, so a script repo can ship them.

# ==================== macOS ====================
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
.localized
# Custom folder icon file. Its name is "Icon" plus a hidden carriage return.
Icon[^ -~]

# ==================== Windows ====================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump
# Download marker files left when copying from Windows or WSL
*Zone.Identifier
# Office lock files (~$report.docx)
~$*

# ==================== Linux ====================
*~
.directory
.fuse_hidden*
.nfs*
.Trash-*

